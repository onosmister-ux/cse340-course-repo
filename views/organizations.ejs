
<%- include("partials/header", { title: title }) %>

<section class="page-heading">
    <p class="eyebrow">DISCOVER</p>
    <h1>Organizations</h1>
    <p>Explore organizations and learn about their activities and goals.</p>
</section>

<section class="content-section">
    <div class="info-card">
        <h2>Explore Organizations</h2>

        <% if (organizations && organizations.length > 0) { %>
            <div class="organizations-list">
                <% organizations.forEach(organization => { %>
                    <article class="organization-card">

                        <% if (organization.logo) { %>
                            <img
                                src="<%= organization.logo %>"
                                alt="<%= organization.organization_name %> logo"
                                class="organization-logo"
                            >
                        <% } %>

                        <h3><%= organization.organization_name %></h3>

                        <% if (organization.description) { %>
                            <p><%= organization.description %></p>
                        <% } %>

                        <% if (organization.contact_email) { %>
                            <p>
                                Contact:
                                <a href="mailto:<%= organization.contact_email %>">
                                    <%= organization.contact_email %>
                                </a>
                            </p>
                        <% } %>

                    </article>
                <% }) %>
            </div>
        <% } else { %>
            <p>No organizations are currently available.</p>
        <% } %>
    </div>
</section>

<%- include("partials/footer") %>
