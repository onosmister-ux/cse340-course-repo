<%- include("partials/header", { title: title }) %>

<section class="page-heading">
    <p class="eyebrow">PARTNER ORGANIZATION</p>
    <h1><%= organization.organization_name %></h1>
</section>

<section class="content-section">
    <div class="info-card">
        <% if (organization.logo) { %>
            <img src="<%= organization.logo %>"
                 alt="<%= organization.organization_name %> logo"
                 class="organization-logo">
        <% } %>

        <p><%= organization.description %></p>
        <p>Contact: <%= organization.contact_email %></p>

        <h2>Service Projects</h2>

        <% if (projects.length > 0) { %>
            <% projects.forEach(project => { %>
                <article class="project-card">
                    <h3>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.project_title %>
                        </a>
                    </h3>
                    <p>Location: <%= project.location %></p>
                </article>
            <% }) %>
        <% } else { %>
            <p>No projects available.</p>
        <% } %>
    </div>
</section>

<%- include("partials/footer") %>